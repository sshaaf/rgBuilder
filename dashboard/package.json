{
  "name": "rgbuilder-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:universe": "vite --open /universe.html",
    "build": "tsc -b && vite build",
    "build:universe": "tsc -b && vite build && node scripts/copy-universe-dist.mjs",
    "sync:universe-fixture": "node scripts/sync-universe-fixture.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:universe": "vitest run src/universe",
    "test:unit": "vitest run src/migration src/MutationsPanel.test.ts",
    "test:mutations": "node scripts/test-mutations-panel.mjs",
    "test:e2e:universe": "playwright test e2e/universe-smoke.spec.ts",
    "test:e2e:universe:ui": "playwright test e2e/universe-smoke.spec.ts --ui"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "codemirror": "^6.0.2",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "preact": "^10.25.4",
    "sigma": "^3.0.2",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.1",
    "@types/three": "^0.185.4",
    "playwright": "^1.61.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
